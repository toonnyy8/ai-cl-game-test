      (au-mix! b f1 0.0 1.2) (au-mix! b f2 0.0 0.6))
    (au-render (growl) () (* (au-rnd) (+ 0.5 (* 0.5 (au-sin (* 30.0 tt)))) (au-adsr tt 0.1 0.3 0.6 0.5 1.6)))
    (au-mix! b (au-svf! growl :bp :from 600 :q 1.5) 0.0 0.5)
