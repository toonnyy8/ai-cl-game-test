(defsound :obliterate (:peak 0.95)
  ;; reverse swell leads in; the impact lands at 0.3 s
  (let* ((b (au-buf 1.9)) (hit 0.3)
         (swell (reverse (au-reverb! (au-fnoise 0.9 :bp 1200 :q 0.8 :decay 0.03) 1.0 :size 1.3 :fb 0.85))))
    (au-mix! b (au-normalize! swell 0.6) (- hit (/ (length swell) (float +au-rate+))))
    (au-thump! b hit 70 24 0.3 0.5 1.0)
    (au-mix! b (au-fnoise 1.2 :lp 180 :decay 0.45) hit 0.7)
    (au-mix! b (au-drive! (au-fnoise 0.2 :lp 2500 :decay 0.04) 4) hit 0.6)
    (dotimes (i 7)   ; gore squelches
      (au-mix! b (au-fnoise 0.25 :bp (au-rrange 250 900) :to (au-rrange 150 400) :q 4 :decay (au-rrange 0.03 0.08))
               (+ hit (au-rrange 0.0 0.4)) (au-rrange 0.25 0.5)))
    (au-reverb! b 0.2 :size 1.3)))

