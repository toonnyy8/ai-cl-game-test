      (let ((det det)) (declare (single-float det))
        (au-render (b) ((ph (+ 0.5 (* 0.5 (au-rnd)))))
          (au-ph+ ph (* det (if (< tt 0.4) (au-sweep tt 55.0 75.0 0.4) (au-sweep (- tt 0.4) 75.0 48.0 1.6))
                        (+ 1.0 (* 0.02 (au-sin (* 5.5 tt))))))
          (* 0.3 (au-adsr tt 0.15 0.3 0.7 0.5 1.6) (au-saw ph)))))
