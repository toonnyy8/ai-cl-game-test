(defsound :rain (:peak 0.35 :loop t)
  ;; 4 s loop (+1 s rendered for the crossfade): pink hiss + droplets
  (let ((b (au-buf 5.0)) (hiss (au-buf 5.0)))
    (au-render (hiss) ((b0 0.0) (b1 0.0) (b2 0.0))
      (let ((w (au-rnd)))
        (setf b0 (+ (* 0.99765 b0) (* w 0.099046))
              b1 (+ (* 0.963 b1) (* w 0.2965164))
              b2 (+ (* 0.57 b2) (* w 1.0526913)))
        (* 0.25 (+ b0 b1 b2 (* w 0.1848)) (+ 0.85 (* 0.15 (au-sin (* 0.5 tt)))))))
    (au-svf! hiss :hp :from 400)
    (au-svf! hiss :lp :from 7000)
    (au-mix! b (au-normalize! hiss) 0.0 0.6)
    (dotimes (i 420)
      (au-ping! b (au-rrange 0.0 5.0) (au-rrange 1800 6500) (au-rrange 0.003 0.015)
                (* (au-rrange 0.05 0.3) (if (zerop (mod i 23)) 2.5 1.0))))
    (au-fold b (* 4 +au-rate+) t)))

(defsound :music (:peak 0.8 :loop t)
  ;; 96 BPM, 8 bars of 16ths = 128 steps x 0.15625 s = 20 s loop, D minor pentatonic
  (let* ((step 0.15625) (n (* 128 7500)) (len 22.5)
         (b (au-buf len)) (bass (au-buf len)) (lead (au-buf len)) (arp (au-buf len))
         (kick (au-buf 0.5)) (hat (au-fnoise 0.06 :hp 7000 :decay 0.012))
         (ohat (au-fnoise 0.3 :hp 6000 :decay 0.08)) (rim (au-fnoise 0.05 :bp 2500 :q 2 :decay 0.008))
         (roots '(38 34 36 33)))           ; D2 Bb1 C2 A1, two bars each
    (au-thump! kick 0.0 160 48 0.05 0.16 1.0)
    (au-mix! kick (au-fnoise 0.02 :hp 3000 :decay 0.003) 0.0 0.4)
    (au-ping! rim 0.0 1700 0.02 0.8)
    ;; drums
    (dotimes (s 128)
      (let ((bar (floor s 16)) (p (mod s 16)) (at (* s step)))
        (when (member p '(0 6 10)) (au-mix! b kick at 0.9))
        (when (and (= p 13) (oddp bar)) (au-mix! b kick at 0.55))
        (when (and (= p 0) (evenp bar)) (au-taiko! b at 0.9 72))
        (when (and (= bar 7) (member p '(12 14 15))) (au-taiko! b at 0.6 95))
        (when (member p '(4 12)) (au-mix! b rim at 0.5))
        (cond ((= p 14) (au-mix! b ohat at 0.25))
              ((evenp p) (au-mix! b hat at 0.3))
              ((> (au-rnd) -0.2) (au-mix! b hat at 0.12)))))
    ;; bass drone, pumping on the beat
    (loop for r in roots for i from 0 do
      (let ((f (au-midi r)) (at (* i 32 step)))
        (au-saws! bass at 5.0 (list f (* 2 f)) 1.0 :a 0.25 :r 0.4)
        (let ((f f)) (declare (single-float f))
          (au-render (bass :at at :dur 5.4) ((ph 0.0))
            (au-ph+ ph f) (* 0.8 (au-adsr tt 0.25 0.1 1.0 0.4 5.0) (au-sin ph))))))
    (au-svf! bass :lp :from 320 :q 1.1)
    (let ((bass bass))                  ; sidechain-style duck after every beat
      (declare (type f32vec bass) (optimize (speed 3) (safety 0)))
      (dotimes (i (length bass))
        (let ((sb (* 0.625 (au-frac (* (i->f i) +au-dt+ 1.6)))))   ; secs since beat
          (declare (single-float sb))
          (setf (aref bass i) (* (aref bass i) (- 1.0 (* 0.55 (au-env-exp sb 0.12))))))))
    (au-mix! b (au-normalize! bass) 0.0 0.55)
    ;; arp, second half: pentatonic 16ths an octave above the bass root
    (loop for s from 64 below 128 do
      (let* ((root (+ 12 (nth (floor s 32) roots)))
             (m (+ root (nth (mod s 8) '(0 7 12 15 17 15 12 7))))
             (note (au-buf 0.25)) (f (au-midi m)))
        (declare (single-float f))
        (au-render (note) ((ph 0.0)) (au-ph+ ph f) (* (au-ar tt 0.002 0.07) (au-saw ph)))
        (au-svf! note :lp :from 3500 :to 400 :q 2)
        (au-mix! arp note (* s step) (if (zerop (mod s 4)) 0.3 0.2))))
    (au-delay! arp (* 3 step) 0.35 0.4)
    (au-mix! b arp 0.0 0.35)
    ;; shakuhachi lead: (step length-in-steps midi)
    (loop for (s l m) in '((0 6 62) (6 2 65) (8 8 67) (16 4 69) (20 4 67) (24 8 65) (32 6 62) (38 2 60) (40 14 62)
                           (64 4 74) (68 4 72) (72 8 69) (80 4 67) (84 4 69) (88 8 72) (96 6 69) (102 2 67)
                           (104 8 65) (112 14 62))
          do (au-shaku! lead (* s step) (* l step) (au-midi m) 0.5))
    (au-delay! lead (* 3 step) 0.3 0.25)
    (au-reverb! lead 0.5 :size 1.3 :fb 0.82)
    (au-mix! b (au-normalize! lead) 0.0 0.45)
    (au-fold b n)))
