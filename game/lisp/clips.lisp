;;;; clips.lisp — RAVEN EDGE's animation library: named poses and keyframe clips for every
;;;; character (GAME_DESIGN §11.3–11.4), in the engine's DEFPOSE / DEFCLIP DSL (engine/lisp/anim.lisp).
;;;; Channel values are degrees (joints) and metres / degrees (root); see the DSL notes there.
(in-package :raven)

;;; ---------------------------------------------------------------- pose library (§11.3)
(defpose :zero ())
(defpose :stance ()
