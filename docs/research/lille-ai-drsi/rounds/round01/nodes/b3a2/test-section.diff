--- frozen LILLE-CPU-TESTS
+++ cell LILLE-CPU-TESTS
@@ -69,3 +69,130 @@
 (let ((j (kit :lille :jilliel)) (o (kit :lille :shin)) (ok (kit :lille :shin-kin)))
   (check (and (equal (getf (kit-ai o) :switch) '(:traces 3 :near 0.6 :whiff 1.5)) (equal (getf (kit-ai ok) :switch) '(:gg 40))
               (getf (kit-ai ok) :trompete) (equal (getf (kit-ai o) :stance) (getf (kit-ai j) :stance)))))
+;; the sniper's HARD layer (dream-rsi round 1 cell b1a0, DUEL_LILLE §24): every level 0 at EASY and NORMAL (the shipped CPU,
+;; no new roll there), 1 at HARD; no brain (a human) none
+(check (and (every (lambda (k) (and (~= 0.0 (getf k :easy)) (~= 0.0 (getf k :normal)) (~= 1.0 (getf k :hard))))
+                   (list *lb-ai-web* *lb-ai-kin-run* *lb-ai-starve* *lb-ai-hunt* *lb-ai-link-k* *lb-ai-hosha-loop* *lb-ai-sp-end*))
+            (~= 0.0 (lb-ai-level *lb-ai-web* nil))
+            (equal *lb-ai-web-band* '(2.5 13.0)) (= *lb-ai-web-every* 6) (= *lb-ai-web-k* 1) (equal *lb-ai-web-volley* '(14 28))
+            (= *lb-ai-web-wary* 2) (~= *lb-ai-web-margin* 0.15) (~= *lb-ai-kin-run-fs* 9.0) (equal *lb-ai-hunt-band* '(0.0 7.5))
+            ;; the web's band ends where TENSHIN in still brings KIN's J1 to him
+            (<= (second *lb-ai-web-band*) (+ *lb-switch-in* *lb-switch-stop*))
+            ;; the cash-out (:sp-ender) on the base form and Jilliel KIN only (not EN, whose SP2 lays a trace; not the owl)
+            (eq (getf (kit-ai (kit :lille :base)) :sp-ender) 'lb-ai-sp-ender)
+            (eq (getf (kit-ai (kit :lille :jilliel-kin)) :sp-ender) 'lb-ai-sp-ender)
+            (null (getf (kit-ai (kit :lille :jilliel)) :sp-ender)) (null (getf (kit-ai (kit :lille :shin-kin)) :sp-ender))))
+;; the volley: one hit group on a free opponent, 2 from 14 frames of his commitment, 3 from 28; the wary read: after 2
+;; missed web switches in a row only a committed opponent (running, in a move, reeling)
+(check (and (= 1 (lb-ai-volley-k nil)) (= 1 (lb-ai-volley-k 13)) (= 2 (lb-ai-volley-k 14)) (= 2 (lb-ai-volley-k 27))
+            (= 3 (lb-ai-volley-k 28)) (= 3 (lb-ai-volley-k 99 '(14 28) 3))
+            (lb-ai-web-wary-p 0 :idle) (lb-ai-web-wary-p 1 :guard) (not (lb-ai-web-wary-p 2 :idle))
+            (lb-ai-web-wary-p 2 :run) (lb-ai-web-wary-p 5 :move) (lb-ai-web-wary-p 2 :stun) (not (lb-ai-web-wary-p 3 :step))))
+;; the volley's 2nd group is J2's line: from J1's active end, J2 (chained in J1's last *CHAIN-LEAD* frames), its line, its
+;; active end and the 2 f cancel all fit inside the commitment it waits for
+(let* ((j1 (kit-command-move (kit :lille :jilliel) :q)) (j2 (find-move :lb-e-j2)))
+  (check (<= (+ (- (mv-r j1) *chain-lead*) (mv-s j2) (mv-a j2) *lb-switch-windup-c*) (first *lb-ai-web-volley*))))
+;; the sniper's discipline (dream-rsi round 1 cell b3a0, DUEL_LILLE §24): its levels 0 / 0 / 1 (EASY / NORMAL the shipped
+;; CPU), its knobs
+(check (and (every (lambda (k) (and (~= 0.0 (getf k :easy)) (~= 0.0 (getf k :normal)) (~= 1.0 (getf k :hard))))
+                   (list *lb-ai-space* *lb-ai-xfire* *lb-ai-clean*))
+            (~= *lb-ai-space-near* 2.4) (~= *lb-ai-space-rush* 5.0) (= *lb-ai-xfire-life* 45) (= *lb-ai-guard-read* 2)))
+;; the spacing rule: a HOSHA from *LB-AI-SPACE-NEAR* lands its first bullet (f6 of the leap, which stops *LUNGE-STOP* short)
+;; outside base J1's reach + 0.2 (the generic ORANGE window); its risk test and the branch instead (TAISHA on a reeling
+;; opponent, the dash back then HOSHA on an open one, TAISHA without the dash)
+(let* ((d *lb-ai-space-near*) (leap (min *lb-hosha-leap* (- d *lunge-stop*))))
+  (check (> (- d (* leap (/ 6.0 *lb-hosha-leap-f*))) (+ (mv-reach (find-move :lb-j1)) 0.2))))
+(check (and (lb-ai-space-risk-p 70.0 nil 2.3 nil) (not (lb-ai-space-risk-p 69.9 nil 2.3 nil))
+            (not (lb-ai-space-risk-p 100.0 :orange 2.3 nil)) (not (lb-ai-space-risk-p 100.0 nil 2.4 nil))
+            (lb-ai-space-risk-p 100.0 nil 7.3 t) (not (lb-ai-space-risk-p 100.0 nil 7.4 t))
+            (eq :k (lb-ai-space-plan t t)) (eq :dash-j (lb-ai-space-plan nil t)) (eq :k (lb-ai-space-plan nil nil))))
+;; the combo enders: KIN's crumple NIJUSHI-KO, a stagger SANREN; the base form's crumple L, else HIRENKYAKU; EN none; each
+;; still combos (SANREN's first line inside J3's stagger, NIJUSHI-KO's beam by the end of K3's crumple, HIRENKYAKU's shot
+;; inside the stagger)
+(let ((rf *reaction-frames*))
+  (check (and (eq :sp2 (lb-ai-ender-sp :jilliel-kin :crumple)) (eq :sp1 (lb-ai-ender-sp :jilliel-kin :stagger))
+              (eq :sp1 (lb-ai-ender-sp :shin-kin :stagger)) (eq :sig (lb-ai-ender-sp :base :crumple))
+              (eq :sp2 (lb-ai-ender-sp :base :stagger)) (null (lb-ai-ender-sp :jilliel :stagger))
+              (< (mv-s (find-move :lb-sanren)) (getf rf :stagger)) (<= (mv-s (find-move :lb-nijushi)) (getf rf :crumple))
+              (< (mv-s (find-move :lb-hiren)) (getf rf :stagger)))))
+;; the crossfire: from KIN K3's hit, its active end (the L link's chain), TENSHIN out's dash to its link, EN J1 to its
+;; active end and the 2 f cancel all fit inside K3's crumple
+(let ((k3 (find-move :lb-w-k3)) (j1 (find-move :lb-e-j1)))
+  (check (< (+ (mv-a k3) *lb-switch-f* (mv-s j1) (mv-a j1) *lb-switch-windup-c*) (getf *reaction-frames* :crumple))))
+;; the refusals: the Breaker; a Kikon only on a non-red opponent with an answer off the same link; nothing else
+(check (and (lb-ai-refuse-p :breaker nil nil) (lb-ai-refuse-p :breaker t t) (lb-ai-refuse-p :kikon nil t)
+            (not (lb-ai-refuse-p :kikon t t)) (not (lb-ai-refuse-p :kikon nil nil)) (not (lb-ai-refuse-p :q nil t))
+            (not (lb-ai-refuse-p :sp1 nil t))))
+;; the refine (dream-rsi round 1 cell b3a1, DUEL_LILLE §24; b3a0's engines + the other lineages' located fixes, the
+;; pendulum's route, the lines before KIN, KIN's snipe): every level 0 at EASY and NORMAL (the shipped CPU), 1 at HARD; no
+;; brain (a human) none (the hunt's band from 0 m, pinned above)
+(check (and (every (lambda (k) (and (~= 0.0 (getf k :easy)) (~= 0.0 (getf k :normal)) (~= 1.0 (getf k :hard))))
+                   (list *lb-ai-rush-wary* *lb-ai-siege* *lb-ai-oki* *lb-ai-kin-exit* *lb-ai-kin-hold* *lb-ai-turtle*
+                         *lb-ai-held-aim* *lb-ai-kin-cash* *lb-ai-en-exit* *lb-ai-route* *lb-ai-kin-snipe* *lb-ai-composure*))
+            (~= 0.0 (lb-ai-level *lb-ai-oki* nil)) (~= 0.0 (lb-ai-level *lb-ai-route* nil))
+            ;; the composure: J held from the stance's shot / HOSHA / TAISHA through its hit frames (no reflex, no ORANGE,
+            ;; on their hits) and HOSHA's link frame
+            (= *lb-ai-composure-f* 18)
+            (>= *lb-ai-composure-f* (getf (mv-params (find-move :lb-k-j)) :link))
+            (>= *lb-ai-composure-f* (reduce #'max (map 'list #'hw-to (mv-hits (find-move :lb-k-j)))))
+            (>= *lb-ai-composure-f* (mv-s (find-move :lb-k-k))) (>= *lb-ai-composure-f* (mv-s (find-move :lb-k-shot)))))
+;; the wake-up shot: frames until a downed / waking fighter can be hit, seen DELAY frames late (pure); the charged shot's
+;; lead (the stance up + the charge + the shot's startup: 40) fits a down + wake-up seen at HARD's delay
+(check (and (= 52 (lb-wake-left :down 0 8)) (= 22 (lb-wake-left :down 30 8)) (= 12 (lb-wake-left :wakeup 10 8))
+            (null (lb-wake-left :idle 0 8)) (null (lb-wake-left :stun 5 8))
+            (= 40 (lb-ai-oki-lead)) (<= (lb-ai-oki-lead) (lb-wake-left :down 0 8)) (lb-kamae-charged-p *lb-charge-f*)
+            ;; ... too late for it, HIRENKYAKU pressed 16-18 frames before: its X-Axis shot (f20) on or just after that frame
+            (equal *lb-ai-oki-hiren* '(16 18)) (= 20 (mv-s (find-move :lb-hiren)))
+            (>= (mv-s (find-move :lb-hiren)) (second *lb-ai-oki-hiren*))
+            (< (second *lb-ai-oki-hiren*) (- (lb-ai-oki-lead) 2))
+            (eq :lb-hiren (mv-name (kit-command-move (kit :lille :base) :sp2)))))
+;; the turtle's / held aim's stance plans TAISHA within 3 m: the generic guard-break range lies inside, and TAISHA's line
+;; (from 3 m further back) still reaches him from there
+(check (and (<= *ai-guard-break-range* 3.0)
+            (>= (- (mv-reach (find-move :lb-k-k)) *lb-taisha-slide*) *ai-guard-break-range*)))
+;; the SP1s his CPU uses for lines: Jilliel KIN SANREN (the cash, the snipe, KIN MUJITTAI's exit), EN SANREN / the owl's
+;; EN 裁きの光明 (EN MUJITTAI's exit, the poor web: they lay traces, no flash step), the owl's KIN MISUJI
+(check (and (eq :lb-sanren (mv-name (kit-command-move (kit :lille :jilliel-kin) :sp1)))
+            (eq :lb-sanren (mv-name (kit-command-move (kit :lille :jilliel-kin-mujittai) :sp1)))
+            (eq :lb-misuji (mv-name (kit-command-move (kit :lille :shin-kin-mujittai) :sp1)))
+            (eq :lb-e-sanren (mv-name (kit-command-move (kit :lille :jilliel-mujittai) :sp1)))
+            (eq :lb-oe-sabaki (mv-name (kit-command-move (kit :lille :shin-mujittai) :sp1)))
+            (zerop (lb-trace-cost :sp1))
+            (eq :lb-switch (mv-name (kit-command-move (kit :lille :jilliel-kin-mujittai) :sig)))))
+;; the pendulum's route: KIN's J1 has K2s after it, K2s only K3; K3 crumples (the crossfire's opening)
+(let ((kk (kit :lille :jilliel-kin)))
+  (check (and (eq :lb-w-k2s (mv-name (kit-next kk :lb-w-j1 :f))) (eq :lb-w-k3 (mv-name (kit-next kk :lb-w-k2s :f)))
+              (null (kit-next kk :lb-w-k2s :q))
+              (eq :crumple (hw-react (svref (mv-hits (find-move :lb-w-k3)) 0))))))
+;; the refine b3a2 (dream-rsi round 1, DUEL_LILLE §24: the burst read, the sniper's step, the blow-away aim): every level
+;; 0 at EASY and NORMAL (the shipped CPU), 1 at HARD; no brain (a human) none
+(check (and (every (lambda (k) (and (~= 0.0 (getf k :easy)) (~= 0.0 (getf k :normal)) (~= 1.0 (getf k :hard))))
+                   (list *lb-ai-burst-read* *lb-ai-close* *lb-ai-blow* *lb-ai-taisha-read*))
+            (~= 0.0 (lb-ai-level *lb-ai-burst-read* nil)) (~= 0.0 (lb-ai-level *lb-ai-blow* nil))))
+;; the burst read: the wait outlasts the burster's invulnerability; REPEL!'s push (read from his own state) hands over to
+;; the perceived break inside the wait; at HARD's delay the perceived look-back (the wait less the delay, + the older SNAP)
+;; fits the brain's ring of 32 SNAPs (components.lisp); a break-free is a reaction left with >= 2 frames to run (or the
+;; air) followed by a free state, never a reaction running out, a landing or a new hit
+(check (and (= *lb-ai-burst-wait* 30) (> *lb-ai-burst-wait* *burst-invuln*) (<= *burst-push-frames* *lb-ai-burst-wait*)
+            (< (+ (- *lb-ai-burst-wait* (getf *ai-delay* :hard)) (getf *ai-delay* :hard) 1) 32)
+            (lb-ai-break-free-p :stun 5 :idle) (lb-ai-break-free-p :stun 2 :move) (lb-ai-break-free-p :air 0 :idle)
+            (lb-ai-break-free-p :stun 30 :guard)
+            (not (lb-ai-break-free-p :stun 1 :idle)) (not (lb-ai-break-free-p :stun 0 :idle))
+            (not (lb-ai-break-free-p :air 0 :down)) (not (lb-ai-break-free-p :stun 9 :stun))
+            (not (lb-ai-break-free-p :stun 9 :guard-hit)) (not (lb-ai-break-free-p :idle 0 :idle))
+            (not (lb-ai-break-free-p :move 9 :idle))))
+;; the blow-away aim: the held stance fires the charged shot only once charged, with his first hittable frame within the
+;; shot's startup (10: it fires on that frame or just after), or him up, or at the hold's end; the hold (90 f) covers a
+;; down and a wake-up (60 f) seen from the stance's f6
+(check (and (= 10 (mv-s (find-move :lb-k-shot)))
+            (lb-ai-blow-fire-p t 10 nil 30) (lb-ai-blow-fire-p t 3 nil 30) (not (lb-ai-blow-fire-p t 11 nil 30))
+            (not (lb-ai-blow-fire-p nil 5 nil 30)) (not (lb-ai-blow-fire-p nil nil t 96))
+            (lb-ai-blow-fire-p t nil t 30) (not (lb-ai-blow-fire-p t nil nil 30))
+            (lb-ai-blow-fire-p t nil nil (+ *lb-kamae-up* *lb-kamae-max*))
+            (>= *lb-kamae-max* (+ (getf *reaction-frames* :down 30) (getf *reaction-frames* :wakeup 30)))
+            (<= *lb-charge-f* *lb-kamae-max*)))
+;; the TAISHA read: TAISHA at a close guard until one is punished, then the dash back and the charged shot (when the
+;; stance's dash can be paid; else TAISHA still)
+(check (and (= *lb-ai-taisha-punished* 1)
+            (eq :k (lb-ai-taisha-plan 0 t)) (eq :dash (lb-ai-taisha-plan 1 t)) (eq :dash (lb-ai-taisha-plan 3 t))
+            (eq :k (lb-ai-taisha-plan 1 nil))))
