 // Also, note that while Firefox's documentation *claims* that a lot of features are unsupported,
 // I've been able to use a lot of them just fine (on Linux nonetheless), so I'm not sure what's up with that.
 
-const WGPUFeatureName WEBGPU_INTERNAL_RequiredFeatures[6] = {
+const WGPUFeatureName WEBGPU_INTERNAL_RequiredFeatures[5] = {
     // These three all have 99.98% coverage on WebGPU devices.
     WGPUFeatureName_Depth32FloatStencil8,
     WGPUFeatureName_RG11B10UfloatRenderable,
-    WGPUFeatureName_IndirectFirstInstance,
     // This one has 98%, and only because of Samsung's weird browser.
     WGPUFeatureName_DepthClipControl,
     // This one has 95%, blame Samsung.
@@ -195,7 +194,9 @@ const WGPUFeatureName WEBGPU_INTERNAL_RequiredFeatures[6] = {
 };
 
 // These are features which we don't *need*, but they'd be really nice to have.
-const WGPUFeatureName WEBGPU_INTERNAL_OptionalFeatures[7] = {
+const WGPUFeatureName WEBGPU_INTERNAL_OptionalFeatures[8] = {
+    // raven-edge patch: optional so SwiftShader (headless tests) works; we never draw indirect.
+    WGPUFeatureName_IndirectFirstInstance,
     // This one has 85%.
     WGPUFeatureName_Float32Blendable,
 
@@ -1383,7 +1384,7 @@ static void WEBGPU_INTERNAL_DeviceLostCallback(WGPUDevice const *device, WGPUDev
     bool debugMode = ((WebGPURenderer *)renderer)->debugMode;
 
     if (debugMode) {
-        SDL_LogError(SDL_LOG_CATEGORY_GPU, "Device has been lost.");
+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "Device has been lost (reason %d): %.*s", (int)reason, (int)message.length, message.data ? message.data : "");
     }
 
     if (!((WebGPURenderer *)renderer)->destroyingSelf) {
@@ -3286,6 +3287,11 @@ static bool WEBGPU_AcquireSwapchainTexture(SDL_GPUCommandBuffer *commandBuffer,
 {
     WebGPUCommandBuffer *cmdBuf = (WebGPUCommandBuffer *)commandBuffer;
 
+    // raven-edge patch: only WaitAndAcquire polled fences, so with the non-blocking acquire the
+    // in-flight count never dropped and every frame after the first got a NULL texture.
+    if (cmdBuf->renderer->submittedCommandBufferCount >= cmdBuf->renderer->maxFramesInFlight) {
+        WEBGPU_INTERNAL_HandlePendingDestroys(cmdBuf->renderer);
+    }
     if (cmdBuf->renderer->submittedCommandBufferCount >= cmdBuf->renderer->maxFramesInFlight) {
         *swapchainTexture = NULL;
         return true;
@@ -4798,11 +4804,19 @@ static void WEBGPU_BindComputeStorageBuffers(SDL_GPUCommandBuffer *commandBuffer
 
 static void WEBGPU_INTERNAL_BindQueuedGraphicsResources(WebGPUCommandBuffer *cmdBuf)
 {
+    // raven-edge patch: only (re)set the bind groups whose resources or uniform offsets changed since
+    // the last draw (pipeline binds mark all four outdated). Was: a cache lookup + 4 SetBindGroup per draw.
+    bool outdated[4] = {
+        cmdBuf->vertexStageBinds.samplerStorageBindGroupOutdated,
+        cmdBuf->vertexStageBinds.uniformBindGroupOutdated,
+        cmdBuf->fragmentStageBinds.samplerStorageBindGroupOutdated,
+        cmdBuf->fragmentStageBinds.uniformBindGroupOutdated,
+    };
     WGPUBindGroup bindGroups[4] = {
-        WEBGPU_INTERNAL_GetBindGroup(cmdBuf, WEBGPU_BINDGROUP_VERTEXSAMPLERSTORAGE),
-        WEBGPU_INTERNAL_GetBindGroup(cmdBuf, WEBGPU_BINDGROUP_VERTEXUNIFORMS),
-        WEBGPU_INTERNAL_GetBindGroup(cmdBuf, WEBGPU_BINDGROUP_FRAGMENTSAMPLERSTORAGE),
-        WEBGPU_INTERNAL_GetBindGroup(cmdBuf, WEBGPU_BINDGROUP_FRAGMENTUNIFORMS),
+        outdated[0] ? WEBGPU_INTERNAL_GetBindGroup(cmdBuf, WEBGPU_BINDGROUP_VERTEXSAMPLERSTORAGE) : NULL,
+        outdated[1] ? WEBGPU_INTERNAL_GetBindGroup(cmdBuf, WEBGPU_BINDGROUP_VERTEXUNIFORMS) : NULL,
+        outdated[2] ? WEBGPU_INTERNAL_GetBindGroup(cmdBuf, WEBGPU_BINDGROUP_FRAGMENTSAMPLERSTORAGE) : NULL,
+        outdated[3] ? WEBGPU_INTERNAL_GetBindGroup(cmdBuf, WEBGPU_BINDGROUP_FRAGMENTUNIFORMS) : NULL,
     };
 
     for (int i = 0; i < 4; i++) {
@@ -5772,6 +5786,20 @@ static bool WEBGPU_PrepareDriver(SDL_VideoDevice *this, SDL_PropertiesID props)
     return true;
 }
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten/em_js.h>
+// raven-edge patch: if the page already requested an adapter and device (async, in JS, before
+// main), import them. Creating the device then never blocks, so no ASYNCIFY/JSPI is needed.
+EM_JS(WGPUAdapter, WEBGPU_INTERNAL_ImportPreinitAdapter, (WGPUInstance instance), {
+    var a = Module['preinitializedWebGPUAdapter'];
+    return a ? WebGPU.importJsAdapter(a, instance) : 0;
+});
+EM_JS(WGPUDevice, WEBGPU_INTERNAL_ImportPreinitDevice, (WGPUInstance instance), {
+    var d = Module['preinitializedWebGPUDevice'];
+    return d ? WebGPU.importJsDevice(d, instance) : 0;
+});
+#endif
+
 static SDL_GPUDevice *WEBGPU_CreateDevice(bool debugMode, bool preferLowPower, SDL_PropertiesID props)
 {
     WebGPURenderer *renderer;
@@ -5821,6 +5849,11 @@ static SDL_GPUDevice *WEBGPU_CreateDevice(bool debugMode, bool preferLowPower, S
         return NULL;
     }
 
+#ifdef __EMSCRIPTEN__
+    renderer->adapter = WEBGPU_INTERNAL_ImportPreinitAdapter(renderer->instance);
+    renderer->device = renderer->adapter ? WEBGPU_INTERNAL_ImportPreinitDevice(renderer->instance) : NULL;
+    if (!renderer->device)
+#endif
     WEBGPU_INTERNAL_RequestAdapter(renderer, &getAdapterSucceeded);
 
     if (!renderer->adapter) {
@@ -5830,7 +5863,9 @@ static SDL_GPUDevice *WEBGPU_CreateDevice(bool debugMode, bool preferLowPower, S
         return NULL;
     }
 
-    WEBGPU_INTERNAL_RequestDevice(renderer, &getDeviceSucceeded);
+    if (!renderer->device) {
+        WEBGPU_INTERNAL_RequestDevice(renderer, &getDeviceSucceeded);
+    }
 
     if (!renderer->device) {
         wgpuAdapterRelease(renderer->adapter);
